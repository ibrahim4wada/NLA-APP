# Application Configuration
NODE_ENV=development
PORT=3000

# Database (Development - adjust for your setup)
DB_USERNAME=db_user
DB_PASSWORD=db_password
DB_NAME=wavedone_dev
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Database (Test - adjust for your setup, ensure this DB exists)
# These are used when NODE_ENV=test
DB_TEST_USERNAME=db_user_test
DB_TEST_PASSWORD=db_password_test
DB_TEST_NAME=wavedone_test
DB_TEST_HOST=localhost
DB_TEST_PORT=5433 # Can be different from dev port

# JWT Configuration
JWT_SECRET=your_super_secret_and_long_jwt_secret_key_min_32_chars_example
JWT_EXPIRES_IN=1h

# Logging Configuration
LOG_LEVEL=debug # For development (options: error, warn, info, http, verbose, debug, silly)
# For production, you might set LOG_LEVEL=info

# Example for Production with DATABASE_URL (if your hosting provider uses it)
# DATABASE_URL=postgres://your_prod_user:your_prod_password@your_prod_host:your_prod_port/your_prod_database_name

# Add other service keys or configurations below
# EMAIL_SERVICE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
```
